{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KittyProtocol Frame Schema",
  "description": "Standard dla wszystkich 9 ramek KittyProtocol",
  "type": "object",
  "required": ["type", "msg_id"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["HELLO", "AUTH", "DATA", "MEOW_OK", "ERROR", "GET_STATUS", "STATUS_RES", "PING", "BYE"]
    },
    "msg_id": { "type": "integer", "description": "Timestamp w milisekundach" },
    "user": { "type": "string" },
    "pass": { "type": "string" },
    "target": { "type": "string" },
    "payload": { "type": "string", "description": "Zaszyfrowany tekst w Base64" },
    "mac": { "type": "string" },
    "code": { "type": "string" },
    "desc": { "type": "string" },
    "status": { "type": "string" },
    "version": { "type": "string" }
  }
}